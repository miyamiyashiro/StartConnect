<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_intro_gradient">


    <LinearLayout
        android:id="@+id/blocoLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/logoGrande"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:src="@drawable/logo_sc_branco"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TUDO COMEÇA COM\nUMA CONEXÃO"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.25"
            android:gravity="center"
            android:fontFamily="@font/montserrat"
            android:textStyle="bold"
            android:alpha="1.0" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="50dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrLogin"
            android:layout_width="150dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#1A7A6E"
            android:text="ENTRAR"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"
            app:elevation="6dp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrCadastro"
            android:layout_width="150dp"
            android:layout_height="52dp"
            android:backgroundTint="#45A09E"
            android:text="CADASTRAR"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"
            app:elevation="6dp"
            app:cornerRadius="10dp" />

    </LinearLayout>

</RelativeLayout>