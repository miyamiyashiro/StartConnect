<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:src="@drawable/foto_vazia"
        app:shapeAppearanceOverlay="@style/CircleImage" />

    <TextView
        android:id="@+id/txtConexaoNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Investidor"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtConexaoTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="\@investidor"
        android:textColor="#E4DDF3"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtConexaoResumo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Favoritou 1 startup"
        android:textColor="#D7D1E9"
        android:textSize="10sp" />

</LinearLayout>