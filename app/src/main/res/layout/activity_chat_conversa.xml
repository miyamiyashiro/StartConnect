<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/conversaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#244444"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnVoltarChat"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Voltar"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgConversaProfile"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/foto_vazia"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <TextView
            android:id="@+id/txtConversaNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Startup"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mensagensRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/chat_input_background"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/etMensagemChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Escrever mensagem"
                android:inputType="textMultiLine"
                android:textColor="#FFFFFF"
                android:textColorHint="#B9D8D8" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviar"
            android:layout_width="108dp"
            android:layout_height="50dp"
            android:text="Enviar"
            android:textAllCaps="false"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#244444"
            android:textSize="14sp"
            android:textStyle="bold|italic"
            app:backgroundTint="#6CB5B5"
            app:cornerRadius="18dp" />
    </LinearLayout>

</LinearLayout>
